# Copy this file to .env.discord on the coordinator only.
# Fill the four required values. Do not commit the completed file.
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=
DISCORD_GUILD_ID=

# Optional trusted Discord user IDs, separated by commas.
# These users can send commands with your machine account's permissions.
DISCORD_ALLOWED_USER_IDS=

# Enable Message Content Intent in the Discord developer portal first.
DISCORD_MESSAGE_CONTENT_INTENT=true

# Optional bootstrap channel restriction. Use a channel outside machine categories.
# DISCORD_CHANNEL_ID=

# Text attachment files expire after this grace period (1-1440 minutes).
DISCORD_ATTACHMENT_TTL_MINUTES=30

# Linux only: optional absolute path to a tmux executable.
# TMUX_BIN=/usr/bin/tmux

# To add remote agents, uncomment these three settings on the coordinator.
# Keep the listener private. Remote agents can use the verified SSH tunnel.
# REMOTE_OPERATOR_AGENT_PORT=8787
# REMOTE_OPERATOR_AGENT_BIND=127.0.0.1
# REMOTE_OPERATOR_AGENT_URL=http://127.0.0.1:8787
