# Copy this file to .env.coordinator on the agent machine only.
# This file configures npm run agent:tunnel. It does not configure GPU hosts.
# Replace the documentation address with the coordinator's reachable IP address.
SSH_HOST=192.0.2.10
SSH_USER=alice
SSH_PORT=22
SSH_PASSWORD=

# Fill this value from an independently verified SSH host fingerprint.
# Format: SHA256: followed by the 43-character fingerprint.
# A literal IP plus a valid fingerprint uses the direct pinned route.
SSH_HOST_KEY_SHA256=

# Set REMOTE_OPERATOR_TUNNEL_PORT in the shell, not in this file.
# Use 8788 when local 8787 is already in use.
